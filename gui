local function C_4()
local script = G2L["4"];
	script.Parent.MouseButton1Click:Connect(function()
	
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local LocalPlayer = Players.LocalPlayer
		local Camera = workspace.CurrentCamera
	
		-- REMOVE OLD ESP
		if LocalPlayer.PlayerGui:FindFirstChild("L4V_BOX_ESP") then
			LocalPlayer.PlayerGui.L4V_BOX_ESP:Destroy()
		end
	
		-- GUI
		local gui = Instance.new("ScreenGui")
		gui.Name = "L4V_BOX_ESP"
		gui.ResetOnSpawn = false
		gui.Parent = LocalPlayer.PlayerGui
	
		local espBoxes = {}
	
		-- CREATE BOX
		local function createESP(player)
	
			if player == LocalPlayer then
				return
			end
	
			local box = Instance.new("Frame")
			box.BackgroundTransparency = 1
			box.BorderSizePixel = 2
			box.Visible = false
			box.Parent = gui
	
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 2
			stroke.Parent = box
	
			local name = Instance.new("TextLabel")
			name.BackgroundTransparency = 1
			name.Size = UDim2.new(1,0,0,20)
			name.Position = UDim2.new(0,0,0,-20)
			name.Text = player.Name
			name.TextScaled = true
			name.Font = Enum.Font.GothamBold
			name.TextStrokeTransparency = 0
			name.Parent = box
	
			espBoxes[player] = {
				Box = box,
				Stroke = stroke,
				Name = name
			}
		end
	
		-- PLAYERS
		for _,plr in pairs(Players:GetPlayers()) do
			createESP(plr)
		end
	
		Players.PlayerAdded:Connect(createESP)
	
		Players.PlayerRemoving:Connect(function(plr)
			if espBoxes[plr] then
				espBoxes[plr].Box:Destroy()
				espBoxes[plr] = nil
			end
		end)
	
		-- RGB EFFECT
		local hue = 0
	
		RunService.RenderStepped:Connect(function()
	
			hue += 0.002
			if hue > 1 then
				hue = 0
			end
	
			local rgb = Color3.fromHSV(hue,1,1)
	
			for player,esp in pairs(espBoxes) do
	
				local char = player.Character
	
				if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
	
					local hrp = char.HumanoidRootPart
					local humanoid = char.Humanoid
	
					if humanoid.Health > 0 then
	
						local pos, visible = Camera:WorldToViewportPoint(hrp.Position)
	
						if visible then
	
							local scale = 1 / (hrp.Position - Camera.CFrame.Position).Magnitude * 100
							local width = math.clamp(35 * scale, 20, 300)
							local height = math.clamp(60 * scale, 35, 500)
	
							esp.Box.Size = UDim2.new(0,width,0,height)
							esp.Box.Position = UDim2.new(0,pos.X - width/2,0,pos.Y - height/2)
	
							esp.Box.Visible = true
	
							esp.Stroke.Color = rgb
							esp.Name.TextColor3 = rgb
	
						else
							esp.Box.Visible = false
						end
	
					else
						esp.Box.Visible = false
					end
	
				else
					esp.Box.Visible = false
				end
			end
		end)
	
	end)
end;
